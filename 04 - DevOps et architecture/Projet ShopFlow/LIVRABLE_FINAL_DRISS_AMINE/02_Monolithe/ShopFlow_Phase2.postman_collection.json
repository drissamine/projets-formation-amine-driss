{
	"info": {
		"_postman_id": "shopflow-phase2-monolith",
		"name": "ShopFlow Phase 2 - Monolith",
		"description": "Collection pour tester le monolithe modulaire ShopFlow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/auth/register"
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"  pm.environment.set(\"jwt_token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/auth/login"
					}
				}
			]
		},
		{
			"name": "Catalog",
			"item": [
				{
					"name": "Get Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:3000/api/products"
					}
				},
				{
					"name": "Create Product (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"MacBook Pro\",\n  \"description\": \"M3 Chip, 16GB RAM\",\n  \"price\": 1999,\n  \"stock\": 5,\n  \"category\": \"Laptops\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/products"
					}
				}
			]
		},
		{
			"name": "Ordering",
			"item": [
				{
					"name": "Place Order",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"REPLACE_WITH_PRODUCT_ID\", \"quantity\": 1 }\n  ]\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/orders"
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "jwt_token", "value": "" }
	]
}

{
	"info": {
		"_postman_id": "shopflow-phase3-micro",
		"name": "ShopFlow Phase 3 - Microservices",
		"description": "Collection pour tester l'architecture distribuée ShopFlow via l'API Gateway.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "0. Gateway Health",
			"request": {
				"method": "GET",
				"header": [],
				"url": "http://localhost:3000/health"
			}
		},
		{
			"name": "1. Identity System",
			"item": [
				{
					"name": "Register Alice",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Alice\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/auth/register"
					}
				},
				{
					"name": "Login Alice",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"  pm.environment.set(\"shopflow_jwt\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/auth/login"
					}
				}
			]
		},
		{
			"name": "2. Catalog Service",
			"item": [
				{
					"name": "Get Products (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:3000/api/products"
					}
				},
				{
					"name": "Add Product (Secure)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{shopflow_jwt}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Microservices Book\",\n  \"price\": 45,\n  \"stock\": 100,\n  \"category\": \"Education\"\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/products"
					}
				}
			]
		},
		{
			"name": "3. Order & Payment Flow",
			"item": [
				{
					"name": "Place Order (Sync Stock Check)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{shopflow_jwt}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    { \"productId\": \"REPLACE_WITH_ID\", \"quantity\": 2 }\n  ]\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/orders"
					}
				},
				{
					"name": "Pay Order (Async Notification)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{shopflow_jwt}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orderId\": \"REPLACE_WITH_ORDER_ID\",\n  \"amount\": 90\n}",
							"options": { "simple": { "language": "json" } }
						},
						"url": "http://localhost:3000/api/payments"
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "shopflow_jwt", "value": "" }
	]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // EMAIL, SMS
  content   String
  status    String   @default("SENT")
  createdAt DateTime @default(now())
}

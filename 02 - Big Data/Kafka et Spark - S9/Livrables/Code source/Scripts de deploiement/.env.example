# Configuration partagée du pipeline
# Copier ce fichier en .env et adapter les chemins locaux.
# Le producteur et Spark tournent sur le host -> ils utilisent le listener PLAINTEXT_HOST
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=streaming-events
KAFKA_TOPIC_DLQ=streaming-events-dlq

# Génération d'événements
EVENTS_PER_SECOND=50
NUM_USERS=200
NUM_VIDEOS=80

# Spark
# Checkpoints Spark : chemin SANS espaces (Hadoop/Windows gère mal les espaces dans les URI)
CHECKPOINT_DIR=/home/user/.tp-kafka-spark/checkpoints
# JDK utilisé par Spark (laisser vide pour utiliser le JAVA_HOME du système).
# Cette clé a priorité sur un JAVA_HOME système éventuellement cassé.
JAVA_HOME_OVERRIDE=
# HADOOP_HOME contenant bin\winutils.exe + bin\hadoop.dll (requis par Spark sous Windows).
HADOOP_HOME_OVERRIDE=
RESULTS_DIR=./results
SQLITE_DB=streaming_analytics.db

# Fenêtres glissantes (Tâche 2.2)
WINDOW_DURATION=10 minutes
SLIDE_DURATION=5 minutes
WATERMARK_DELAY=15 minutes

# Détection d'anomalies
ANOMALY_USER_VIDEOS_THRESHOLD=10
ANOMALY_DEVICE_THRESHOLD=1000
{
	"info": {
		"_postman_id": "12345678-1234-1234-1234-123456789abc",
		"name": "Social Network - Posts API Tests",
		"description": "Collection complète pour tester l'API posts du réseau social",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Create Post",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"contenu\": \"Mon premier post de test\",\n  \"auteur\": \"{{userId}}\",\n  \"images\": [\"https://picsum.photos/400/300\"]\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/posts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"posts"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Post créé avec succès\", function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.success).to.be.true;",
							"    pm.expect(responseJson.data).to.have.property('_id');",
							"    pm.expect(responseJson.data.contenu).to.be.a('string');",
							"    ",
							"    // Stocker l'ID du post pour les tests suivants",
							"    pm.environment.set('postId', responseJson.data._id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "2. Get All Posts",
			"request": {
				"method": "GET",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{baseUrl}}/posts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"posts"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Liste de posts récupérée\", function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.success).to.be.true;",
							"    pm.expect(responseJson).to.have.property('data');",
							"    pm.expect(responseJson.data).to.be.an('array');",
							"    pm.expect(responseJson).to.have.property('count');",
							"});",
							"",
							"pm.test(\"Populate des auteurs\", function () {",
							"    const responseJson = pm.response.json();",
							"    if (responseJson.data.length > 0) {",
							"        pm.expect(responseJson.data[0].auteur).to.have.property('nom');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},

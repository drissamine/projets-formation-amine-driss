        <mxCell id="r2c" value="1 — actif" style="text;html=1;fillColor=#D5E8D4;fontColor=#2e5020;fontStyle=1;align=center;verticalAlign=middle;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="920" y="156" width="80" height="32" as="geometry" /></mxCell>

        <mxCell id="ann" value="① Même ClientID (C001) = même client réel (clé naturelle).&#10;② ClientKey distincte (1001, 1002) = une ligne par version (clé de substitution).&#10;③ Date_fin = 9999-12-31 et Courant = 1 → version active.&#10;④ L'ancienne ligne est fermée, une nouvelle est créée — aucun écrasement." style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#444;spacing=2;" vertex="1" parent="1"><mxGeometry x="540" y="196" width="460" height="86" as="geometry" /></mxCell>

        <!-- BLOC 3 : comparaison -->
        <mxCell id="h3" value="③ Comparaison SCD Type 1 / 2 / 3" style="text;html=1;align=left;fontStyle=1;fontSize=13;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="400" height="22" as="geometry" /></mxCell>

        <mxCell id="t1" value="&lt;b&gt;SCD Type 1 — Écrasement&lt;/b&gt;&lt;br&gt;La nouvelle valeur remplace l'ancienne.&lt;br&gt;✗ Aucun historique conservé.&lt;br&gt;Simple, rapide, volume stable.&lt;br&gt;&lt;i&gt;Usage : attributs sans intérêt historique.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="t2" value="&lt;b&gt;SCD Type 2 — Historisation ★&lt;/b&gt;&lt;br&gt;Nouvelle ligne + dates de validité + flag.&lt;br&gt;✓ Historique complet conservé.&lt;br&gt;Inconvénient : croissance du volume.&lt;br&gt;&lt;b&gt;&lt;i&gt;Recommandé : Client, Produit, Prix.&lt;/i&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#5a9c3a;strokeWidth=2.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="370" y="335" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="t3" value="&lt;b&gt;SCD Type 3 — Historique limité&lt;/b&gt;&lt;br&gt;Colonne « valeur précédente ».&lt;br&gt;~ Garde uniquement avant / après.&lt;br&gt;Volume stable, historique partiel.&lt;br&gt;&lt;i&gt;Compromis entre Type 1 et Type 2.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="300" height="125" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
